{
  "name": "anti-slope",
  "version": "0.1.0",
  "private": true,
  "description": "Tools and workflows for careful human review of AI-generated work. First product: Minesweeper.",
  "repository": {
    "type": "git",
    "url": "https://github.com/funbam99/antislope-v1.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "metadata:summary": "node scripts/summarize-metadata.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
